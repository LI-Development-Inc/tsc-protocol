# =============================================================================
# TSC Protocol — Test Environment Variables
# =============================================================================
#
# Copy this file and fill in your values:
#   cp .env.test.example .env.test
#   source .env.test
#
# NEVER commit .env.test — it contains your mnemonic phrase.
# .env.test is listed in .gitignore.
#
# Usage with make:
#   source .env.test && make test-p1
#   source .env.test && make daemon-start
# =============================================================================

# ── Identity ──────────────────────────────────────────────────────────────────

# Your 24-word BIP-39 mnemonic phrase.
# Required for: daemon-start (vault unlock), test-p1 (recover), test-p1-1 (rotation)
# Generate with: make daemon-ephemeral && tsc-cli init (then save the words)
# IMPORTANT: no spaces around = in bash export
export TSC_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"

# ── Phase 2: Remote peer tests ────────────────────────────────────────────────

# GhostID of the remote peer daemon (Phase 2.2 / 2.3 tests)
# Obtain with: ssh <vps> "cd tsc-work && ./target/debug/tsc-cli status" | grep GhostID
# export TSC_GHOST_B="<64-char hex ghost id>"

# ── Optional overrides ────────────────────────────────────────────────────────

# Override the GSP listen port (default: 9090)
# export TSC_PORT=9090

# Override the daemon log location (default: /tmp/tscd-test.log)
# export DAEMON_LOG=/tmp/tscd-test.log
